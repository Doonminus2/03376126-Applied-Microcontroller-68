{
  "version": 1,
  "author": "Final Homework ESP32 Digital Clock",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ds1307", "id": "rtc", "top": -120, "left": 200, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": 60, "left": 200, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 20, "left": -160, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn_mode", "top": 300, "left": -80, "attrs": { "color": "red", "label": "MODE", "key": "m" } },
    { "type": "wokwi-pushbutton", "id": "btn_set", "top": 300, "left": 20, "attrs": { "color": "green", "label": "SET", "key": "s" } },
    { "type": "wokwi-pushbutton", "id": "btn_alarm", "top": 300, "left": 120, "attrs": { "color": "yellow", "label": "ALARM", "key": "a" } },
    { "type": "wokwi-pushbutton", "id": "btn_lap", "top": 300, "left": 220, "attrs": { "color": "blue", "label": "LAP/RST", "key": "l" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.2", "rtc:GND", "black", [ "v0" ] ],
    [ "esp:5V", "rtc:5V", "red", [ "v0" ] ],
    [ "esp:21", "rtc:SDA", "green", [ "h0" ] ],
    [ "esp:22", "rtc:SCL", "blue", [ "h0" ] ],
    [ "esp:GND.2", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "green", [ "h0" ] ],
    [ "esp:22", "oled:SCL", "blue", [ "h0" ] ],
    [ "esp:25", "buzzer:2", "orange", [ "h0" ] ],
    [ "esp:GND.3", "buzzer:1", "black", [ "h0" ] ],
    [ "esp:18", "btn_mode:1.l", "red", [ "v0" ] ],
    [ "esp:GND.1", "btn_mode:2.l", "black", [ "v0" ] ],
    [ "esp:19", "btn_set:1.l", "green", [ "v0" ] ],
    [ "esp:GND.1", "btn_set:2.l", "black", [ "v0" ] ],
    [ "esp:4", "btn_alarm:1.l", "gold", [ "v0" ] ],
    [ "esp:GND.1", "btn_alarm:2.l", "black", [ "v0" ] ],
    [ "esp:5", "btn_lap:1.l", "blue", [ "v0" ] ],
    [ "esp:GND.1", "btn_lap:2.l", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
